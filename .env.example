# ---- ProvingGround platform -------------------------------------------------
# Optional. Nothing here is required: every value below is already the default.
# Copy to .env only to change something (real LLM keys, passwords, Langfuse, another database).

# Admin API key (dashboard + CLI writes) and OTLP ingest key (agents sending traces)
PGROUND_API_KEY=dev-admin-key
PGROUND_INGEST_KEY=dev-ingest-key

# Who can sign in to the dashboard: name:password pairs, separated by commas (so a password can't
# contain a comma). Change this before anyone else can reach the dashboard. Editing it signs
# everyone out. The compose stack defaults to the login below; outside compose there is no
# default and nobody can sign in until you set it.
PGROUND_WEB_USERS=admin:provingground

# Database used by the API and worker
PGROUND_DATABASE_URL=postgresql+asyncpg://pground:pground@localhost:5432/pground

# Where the CLI pushes results / pulls baselines (optional)
PGROUND_API_URL=http://localhost:8000

# Trace export: uncomment to also send the spans of CLI runs to the dashboard (the ingest key
# authenticates them). The compose demo agents already send theirs.
# PGROUND_OTLP_ENDPOINT=http://localhost:8000/v1/traces

# Keep prompts/answers out of traces entirely (privacy): set to 0
PGROUND_TRACE_CONTENT=1

# false: leave out the demo company and start with an empty fleet you fill from the
# dashboard's Upload agent page
# PGROUND_DEMO=false

# Uploaded folders with a bot.py run that code in the worker. The compose stack allows it
# (it's your machine); never allow it on a dashboard other people can reach.
# PGROUND_ALLOW_CODE_UPLOADS=true

# Grafana admin password for the compose stack
GRAFANA_PASSWORD=admin

# Simulated models: 0 = return instantly (tests/CI), 1 = sleep the full simulated latency.
# Leave it unset for the compose demo, which uses 0.25 so live traces get realistic timings.
# PGROUND_SIM_TIME_SCALE=0

# ---- Real LLM providers (optional; nothing requires them) ------------------
# A key alone changes nothing: it is used once a config names that provider, e.g.
# `judge: {model: anthropic/claude-opus-5-5}` or a target's `model: openai/gpt-5-mini`.
# The pground CLI reads this file; for the compose stack, re-run `docker compose up -d` after editing.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# GEMINI_API_KEY=

# ---- Optional Langfuse export ----------------------------------------------
# LANGFUSE_HOST=https://cloud.langfuse.com
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
