# ---- ProvingGround platform -------------------------------------------------
# Copy to .env and adjust. Everything works offline with the defaults below.

# Admin API key (dashboard + CLI writes) and OTLP ingest key (agents sending traces)
PGROUND_API_KEY=dev-admin-key
PGROUND_INGEST_KEY=dev-ingest-key

# Database used by the API and worker
PGROUND_DATABASE_URL=postgresql+asyncpg://pground:pground@localhost:5432/pground

# Where the CLI pushes results / pulls baselines (optional)
PGROUND_API_URL=http://localhost:8000

# Simulated models: 0 = return instantly (tests/CI), 1 = sleep the simulated latency (live demo)
PGROUND_SIM_TIME_SCALE=0

# ---- Real LLM providers (optional; nothing requires them) ------------------
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=

# ---- Optional Langfuse export ----------------------------------------------
# LANGFUSE_HOST=https://cloud.langfuse.com
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
