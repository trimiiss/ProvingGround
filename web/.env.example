# Dashboard settings. Copy to .env.local for `npm run dev`.

# Server side only: the dashboard talks to the API with the admin key, which never reaches the browser.
PGROUND_API_URL=http://localhost:8000
PGROUND_API_KEY=dev-admin-key

# Links shown in the browser (baked in at build time)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_GRAFANA_URL=http://localhost:3001
NEXT_PUBLIC_PROMETHEUS_URL=http://localhost:9090
